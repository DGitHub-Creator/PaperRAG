# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.whl
*.egg-info

# Virtual environments
.venv
.env
# prod compose 的密钥文件（docker compose --env-file .env.production ...）。
# 只写 .env 不写它会让人以为它是安全的：`.env.production.example` 里那句
# "compose 服务: minio" 对应的真密钥同样不该入库（AGENTS.md §7「密钥只经环境变量」）。
.env.production

#Docker files
volumes/

# OS files
.DS_Store
data/
logs/

# Test artifacts
tests/__pycache__/
tests/**/__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# AI/编辑器工具的本地产物：会话记录、计划草稿、缓存。这些是"某次对话的中间态"，
# 不是仓库的真相源——真相源只有 docs/（rules/ 与 plans/）与 docs/progress.json。
.mimocode/
.claude/
.qoder/
.cursor/
.aider*
.windsurf/
.trae/
*.code-workspace

# Study
langchain-study/

# Large model files (download locally, do not commit)
models/
*.bin
*.safetensors

# Frontend dependencies
frontend/node_modules/

# 本机运行产物：仓库只保留"能跑的最小状态"，这些一律不入库。
# 根级 node_modules/ 是误在仓库根执行 npm install 的产物（依赖应装在 frontend/）。
node_modules/
.tmp/
.tmp-pytest/
.pytest-cache/

# Playwright 的失败现场：截图与 DOM 快照。**每次跑都重新生成**，
# 留在工作区里会让人拿上一轮的快照诊断这一轮的失败（P0-9 那次就是这么绕了一圈）。
frontend/test-results/
frontend/playwright-report/

# Cloned repos
citelocal-agent/

# Compose plans
docs/compose/
