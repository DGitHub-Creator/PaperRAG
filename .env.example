# ===== 运行环境 =====
# development（默认）| production。production 会翻转一组安全默认值
# （USE_REDIS_JOB_MANAGER、限流、缓存等），见 backend/core/config/__init__.py 的 env_presets。
# APP_ENV=development

# ===== LLM Provider 统一配置（推荐使用） =====
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_GRADE_MODEL=gpt-4.1
# LLM_API_KEY=sk-
# LLM_BASE_URL=https://api.openai.com/v1

# ===== LLM 旧变量（向后兼容，新项目请使用上方统一配置）=====
# ARK_API_KEY=7a
# MODEL=doubao-seed-2-0-pro-260215
# GRADE_MODEL=doubao-seed-2-0-lite-260215
# FAST_MODEL=doubao-seed-1-6-flash-250828
# BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 本地密集向量（langchain_huggingface / sentence-transformers）
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu
# DENSE_EMBEDDING_DIM=1024
# HF 模型缓存目录（默认项目根下 models/）
# HF_HOME=./models

# ===== JSON 结构化日志（设置 true 后日志输出 JSON 格式，适合 APM 采集）=====
# JSON_LOG=false

# ===== Rerank (可选，不配则自动降级) =====
# RERANK_MODEL=jina-reranker-v3
# RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
# RERANK_API_KEY=jina_

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# BM25 稀疏统计持久化（默认项目根下 data/bm25_state.json）
# BM25_STATE_PATH=

# ===== 本地 Reranker（设置 true 后优先使用本地 BGE-Reranker-v2-M3）=====
# LOCAL_RERANKER=false

# ===== 语义缓存 =====
# ENABLE_CACHE=true
# CACHE_MAX_SIZE=500
# CACHE_TTL_SECONDS=604800
# CACHE_SIM_THRESHOLD=0.92

# ===== 文档解析 =====
# 并行解析工作线程数
# PARSE_MAX_WORKERS=4
# 学术论文文本清洗（移除页眉页脚、引用块等）
# ENABLE_ACADEMIC_CLEANING=true
# 基于文档结构的分块（Markdown 标题粗分 + 递归字符切分兜底）
# ENABLE_STRUCTURAL_CHUNKING=true
# 分块参数
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100

# ===== 上下文扩展 =====
# ENABLE_CONTEXT_EXPANSION=true
# EXPAND_PREV_PARENT=1
# EXPAND_NEXT_PARENT=1
# EXPAND_MAX_TOTAL_CHUNKS=30

# ===== CORS（生产环境必须限制来源）=====
# ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com

# ===== 数据库连接池 =====
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ===== 数据库/缓存地址（默认值已指向本机，这里只是显式化）=====
# 后端跑宿主（dev.py serve）时用 127.0.0.1；跑容器时由 compose 注入服务名（postgres / redis）。
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/langchain_app
# REDIS_URL=redis://127.0.0.1:6379/0
#
# 注意：scripts/audit_schema.py --live 是**直接读环境变量** DATABASE_URL 的（不读
# backend.core.config 的默认值），跑真库审计前需要显式导出，否则它会以为本机没有 PG：
#   PowerShell: $env:DATABASE_URL='postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/langchain_app'

# ===== 任务管理器（Redis 模式支持多 worker / 重启恢复）=====
# USE_REDIS_JOB_MANAGER=false

# ===== 认证 =====
# 必填：留空时应用启动即报错拒绝启动（不再有可猜测的默认密钥）。
# 生成强随机值: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# 访问令牌有效期（分钟），默认 60
# JWT_EXPIRE_MINUTES=60
# 管理员邀请码：不配置则注册接口无法创建 admin 账户
# ADMIN_INVITE_CODE=
# 管理员种子账号（uv run python scripts/dev.py seed-admin，走 Go 的 cmd/seed）：
# 账号与口令只从环境变量读；ADMIN_PASSWORD 必填，缺了直接拒绝创建。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# 要连既有管理员的口令一起重置的，显式设 ADMIN_RESET_PASSWORD=1（默认不覆盖）。
# ADMIN_RESET_PASSWORD=

# ===== 限流 =====
# 全局限流规格，留空=不启用（开发默认；APP_ENV=production 时默认 60/minute）
# RATE_LIMIT=60/minute
# 仅当服务确实部署在可信反向代理之后才开启：限流键改取 X-Forwarded-For 首跳。
# 直连场景开启会让客户端伪造该头绕过限流。
# TRUST_PROXY_HEADERS=true

# ===== Go ↔ ai-core 内部令牌 =====
# P0-7 已接通：Go 发 Authorization: Bearer <此值>，/internal/v1/ai/* 校验。
# 留空则该面拒绝一切请求（不是不鉴权）；生产必须配强随机值且 ai-core 不发布宿主端口。
# dev 形态下 `dev.py serve` 默认只绑 127.0.0.1，所以这一面在本机不对局域网开放。
# ⚠️ 跑 chain 的内部执行面用例时，服务与用例要用**同一个值**：
#   $env:AICORE_INTERNAL_TOKEN='<随机值>'; uv run python scripts/dev.py serve --no-reload
#   uv run python -m pytest -m chain -k ai_executions
# AICORE_INTERNAL_TOKEN=

# ===== go-api / go-worker 自己的配置 =====
# 这两个进程读的是同一份 .env（键名与 Python 侧一致，两侧必须拿到同一个值）。
# PORT：监听端口，默认 :8080（dev 的单一入口）。attu 已让位到 3001。
# PORT=8080
# go-worker 用（P3 才起调度）：服务名进 slog 固定字段，prod 下 DATABASE_URL 缺失即拒绝启动。
# SERVICE=go-api
# 单项依赖探测超时，默认 3s，与 backend/api/health.py 对齐。写成 "3" 或 "3s" 都认。
# READY_TIMEOUT=3s
# VERSION 进 /health 响应体，与 Python 的 version 同位。
# VERSION=dev

# ===== go-api 未迁移路径的上游（dev）=====
# Go 是唯一公开入口；尚未搬到 Go 的面（sessions 详情/chat/documents/ws/内部面）由 Go 反代到这里。
# 每条面的归属与"Python 那条还在不在"登记在 `contracts/route-ownership.md`，由 `scripts/check_route_ownership.py` 机检。
# （14 §19 铁律 2「门面先于重写」）。默认 http://127.0.0.1:8000，即 dev.py serve 起的 Python。
# 生产部署必须显式覆盖成真正的上游地址。
# PYTHON_UPSTREAM=http://127.0.0.1:8000

# Milvus 单次读写与文档写锁等待上限（秒）。
MILVUS_OPERATION_TIMEOUT=30
DOCUMENT_LOCK_TIMEOUT_SECONDS=30

# 开启 TRUST_PROXY_HEADERS 时必须列出可信直连代理网段，禁止无条件采信客户端 X-Forwarded-For。
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
