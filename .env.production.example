# ── PaperRAG 生产环境配置模板 ──────────────────────────────────────
# 复制为 .env.production 并填入真实值：cp .env.production.example .env.production
# docker-compose.prod.yml 会自动加载该文件（backend 服务 env_file）。
#
# 注意：DATABASE_URL / REDIS_URL / MILVUS_HOST / MILVUS_PORT / HF_HOME /
#       USE_REDIS_JOB_MANAGER / APP_ENV 由 compose 内部覆盖，此处无需修改。
# ───────────────────────────────────────────────────────────────────

APP_ENV=production

# Security (REQUIRED — 启动安全校验 fail-fast)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-production-secret
ADMIN_INVITE_CODE=replace-with-a-private-admin-invite-code
# 逗号分隔的站点来源，禁止使用 *（生产校验会拒绝）
ALLOWED_ORIGINS=https://your-domain.example
RATE_LIMIT=60/minute
# 生产形态在 nginx 反代之后：不开启则所有访客共用 nginx 容器 IP 这一个限流计数桶。
# 仅当来源链路上的 X-Forwarded-For 确实由你自己的代理写入时才可开启。
TRUST_PROXY_HEADERS=true
MAX_UPLOAD_SIZE_MB=100

# PostgreSQL（compose 服务: postgres）
POSTGRES_PASSWORD=replace-with-strong-db-password

# Milvus 对象存储（compose 服务: minio）
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# LLM (REQUIRED — validate_config fail-fast)
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=
LLM_MODEL=
LLM_GRADE_MODEL=gpt-4.1

# Vector database（compose 服务: milvus）
MILVUS_COLLECTION=embeddings_collection

# Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANK_MODEL=
RERANK_BINDING_HOST=
RERANK_API_KEY=
LOCAL_RERANKER=false
