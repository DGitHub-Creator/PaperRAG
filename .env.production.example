# ── ResearchPilot 生产环境配置模板 ──────────────────────────────────────
# 复制为 .env.production 并填入真实值：cp .env.production.example .env.production
# ⚠️ 它**不会**被"自动加载"到 compose 的顶层插值：service 级 env_file 只注入容器环境，
#    `${POSTGRES_PASSWORD:?}` / `${MINIO_ACCESS_KEY:?}` 这类插值只看宿主环境，所以启动命令
#    必须显式带 --env-file：
#      docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#    （少这一步三条必填项全报 missing，实测 rc=1；台账 C27）
#
# 注意：DATABASE_URL / REDIS_URL / MILVUS_HOST / MILVUS_PORT / HF_HOME /
#       USE_REDIS_JOB_MANAGER / APP_ENV 由 compose 内部覆盖，此处无需修改。
# ───────────────────────────────────────────────────────────────────

APP_ENV=production

# Security (REQUIRED — 启动安全校验 fail-fast)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-production-secret
ADMIN_INVITE_CODE=replace-with-a-private-admin-invite-code
AICORE_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
# 逗号分隔的站点来源，禁止使用 *（生产校验会拒绝）
ALLOWED_ORIGINS=https://your-domain.example
RATE_LIMIT=60/minute
# 先按直连来源限流；启用代理头必须同时填写实际受控代理网段，禁止使用 0.0.0.0/0。
# 未配置受信网段时开启会被启动校验拒绝。具体入口见 README 的反向代理说明。
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
MAX_UPLOAD_SIZE_MB=100

# PostgreSQL（compose 服务: postgres）
POSTGRES_PASSWORD=replace-with-strong-db-password
# 应用运行账号与迁移管理员分离；均使用 secrets.token_urlsafe(48)，不要用含 URL 保留字符的密码。
GO_DB_USER=researchpilot_go
GO_DB_PASSWORD=replace-with-a-random-go-database-password
PYTHON_DB_USER=researchpilot_python
PYTHON_DB_PASSWORD=replace-with-a-random-python-database-password

# Milvus 对象存储（compose 服务: minio；镜像已换成 versitygw，容器内改名成 ROOT_ACCESS_KEY/ROOT_SECRET_KEY）
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# LLM (REQUIRED — validate_config fail-fast)
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=
LLM_MODEL=
LLM_GRADE_MODEL=gpt-4.1

# Vector database（compose 服务: milvus）
MILVUS_COLLECTION=embeddings_collection

# Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANK_MODEL=
RERANK_BINDING_HOST=
RERANK_API_KEY=
LOCAL_RERANKER=false
